# Merged over defconfig + kvm_guest.config. Server hardware and what the live
# ISO needs to boot. Drivers are modules unless the root filesystem needs them
# before the initramfs can load anything.

CONFIG_LOCALVERSION="-deli"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# CONFIG_MODULE_COMPRESS is not set
CONFIG_DEBUG_INFO_NONE=y

# EFI boot through systemd-boot
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_EFIVAR_FS=y

# A console on screen: UEFI has no VGA text mode, so the kernel needs the
# firmware framebuffer (simpledrm) and a framebuffer console, then the real
# driver: bochs (Proxmox/QEMU default), qxl, virtio-gpu, and the BMC chips
# servers ship with (ASPEED, Matrox G200).
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_BOCHS=m
CONFIG_DRM_QXL=m
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_AST=m
CONFIG_DRM_MGAG200=m
CONFIG_DRM_VMWGFX=m

# Live ISO: dmsquash-live mounts an iso9660 squashfs with an overlay
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=m
CONFIG_BLK_DEV_LOOP=m
CONFIG_BLK_DEV_SR=m
CONFIG_BLK_DEV_DM=m

# Filesystems the installer creates
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_XFS_FS=m
CONFIG_XFS_POSIX_ACL=y
CONFIG_VFAT_FS=m
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ISO8859_1=m
CONFIG_NLS_UTF8=m

# Storage controllers
CONFIG_BLK_DEV_NVME=m
CONFIG_SATA_AHCI=m
CONFIG_SCSI_VIRTIO=m
CONFIG_VIRTIO_BLK=m
CONFIG_MEGARAID_SAS=m
CONFIG_SCSI_MPT3SAS=m
CONFIG_SCSI_SMARTPQI=m
CONFIG_SCSI_HPSA=m
CONFIG_SCSI_AACRAID=m
CONFIG_VMWARE_PVSCSI=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_MD=y
CONFIG_BLK_DEV_MD=m
CONFIG_MD_RAID0=m
CONFIG_MD_RAID1=m
CONFIG_MD_RAID10=m
CONFIG_MD_RAID456=m
CONFIG_DM_CRYPT=m
CONFIG_DM_SNAPSHOT=m
CONFIG_DM_THIN_PROVISIONING=m

# Network adapters common in servers and hypervisors
CONFIG_VIRTIO_NET=m
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_IXGBE=m
CONFIG_I40E=m
CONFIG_ICE=m
CONFIG_BNXT=m
CONFIG_TIGON3=m
CONFIG_BNX2=m
CONFIG_BNX2X=m
CONFIG_MLX4_EN=m
CONFIG_MLX5_CORE=m
CONFIG_MLX5_CORE_EN=y
CONFIG_R8169=m
CONFIG_VMXNET3=m

# Networking features a server is expected to have
CONFIG_BONDING=m
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m
CONFIG_MACVLAN=m
CONFIG_VETH=m
CONFIG_WIREGUARD=m
CONFIG_TCP_CONG_BBR=m
CONFIG_NET_SCH_FQ=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m

# Containers
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Virtualisation host
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_VHOST_NET=m
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m

# Memory and hardware monitoring
CONFIG_ZRAM=m
CONFIG_ZSWAP=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_IPMI_HANDLER=m
CONFIG_IPMI_DEVICE_INTERFACE=m
CONFIG_IPMI_SI=m
CONFIG_X86_MSR=m
CONFIG_X86_CPUID=m
